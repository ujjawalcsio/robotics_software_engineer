<robot name="mobile_manipulator">
    <link name="base_link">
        <visual>
            <geometry>
                <box size="0.5 0.3 0.1"/>
            </geometry>
            <material name="blue">
                <color rgba="0 0 1 1"/>
            </material>
        </visual>
    </link>

    <link name="front_left_wheel">
        <visual>
            <geometry>
                <cylinder radius="0.05" length="0.02"/>
            </geometry>
            <origin rpy="1.5708 0 0" xyz="0 0 0"/>
            <material name="black">
                <color rgba="0 0 0 1.0"/>
            </material>
        </visual>
    </link>

    <link name="front_right_wheel">
        <visual>
            <geometry>
                <cylinder radius="0.05" length="0.02"/>
            </geometry>
            <origin rpy="1.5708 0 0" xyz="0 0 0"/>
            <material name="black"> 
                <color rgba="0 0 0 1.0"/>
            </material>
        </visual>
    </link>

    <link name="rear_left_wheel">
        <visual>
            <geometry>
                <cylinder radius="0.05" length="0.02"/>
            </geometry>
            <origin rpy="1.5708 0 0" xyz="0 0 0"/>
            <material name="black">
                <color rgba="0 0 0 1.0"/>
            </material>
        </visual>
    </link>

    <link name="rear_right_wheel">
        <visual>
            <geometry>
                <cylinder radius="0.05" length="0.02"/>
            </geometry>
            <origin rpy="1.5708 0 0" xyz="0 0 0"/>
            <material name="black">
                <color rgba="0 0 0 1.0"/>
            </material>
        </visual>
    </link>

    <link name="link1">
        <visual>
            <geometry>
                <cylinder radius="0.03" length="0.2"/>
            </geometry>
            <material name="green">
                <color rgba="0 1 0 1"/>
            </material>
        </visual>
    </link>

    <link name="link2">
        <visual>
            <geometry>
                <cylinder radius="0.03" length="0.2"/>
            </geometry>
            <material name="red">
                <color rgba="1 0 0 1"/>
            </material>
        </visual>
    </link>

    <link name="link3">
        <visual>
            <geometry>
                <cylinder radius="0.03" length="0.2"/>
            </geometry>
            <material name="yellow">
                <color rgba="1 1 0 1"/>
            </material>
        </visual>
    </link>

    <joint name="front_left_steering_joint" type="revolute">
        <parent link="base_link"/>
        <child link="front_left_wheel"/>
        <origin xyz="0.2 0.15 0"/>
        <axis xyz="0 0 1"/>
        <limit lower="-0.5" upper="0.5" effort="10.0" velocity="1.0"/>
    </joint>

    <joint name="front_right_steering_joint" type="revolute">
        <parent link="base_link"/>
        <child link="front_right_wheel"/>
        <origin xyz="0.2 -0.15 0"/>
        <axis xyz="0 0 1"/>
        <limit lower="-0.5" upper="0.5" effort="10.0" velocity="1.0"/>
    </joint>

    <joint name="rear_left_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="rear_left_wheel"/>
        <origin xyz="-0.2 0.15 0"/>
        <axis xyz="0 1 0"/>
    </joint>

    <joint name="rear_right_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="rear_right_wheel"/>
        <origin xyz="-0.2 -0.15 0"/>
        <axis xyz="0 1 0"/>
    </joint>

    <joint name="arm_joint1" type="revolute">
        <parent link="base_link"/>
        <child link="link1"/>
        <origin xyz="0 0 0.2"/>
        <axis xyz="0 0 1"/>
        <limit lower="-1.5" upper="1.5" effort="20.0" velocity="1.5"/>
    </joint>

    <joint name="arm_joint2" type="revolute">
        <parent link="link1"/>
        <child link="link2"/>
        <origin xyz="0 0 0.2"/>
        <axis xyz="0 1 0"/>
        <limit lower="-1.5" upper="1.5" effort="20.0" velocity="1.5"/>
    </joint>

    <joint name="arm_joint3" type="revolute">
        <parent link="link2"/>
        <child link="link3"/>
        <origin xyz="0 0 0.2"/>
        <axis xyz="0 1 0"/>
        <limit lower="-1.5" upper="1.5" effort="20.0" velocity="1.5"/>
    </joint>
</robot>
